# Copie este arquivo para .env e substitua os valores ficticios.
# PostgreSQL 16 instalado no Windows e acessado pelos containers.
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_database_password
POSTGRES_DB=gestaodeacao
HOST_POSTGRES_PORT=5432

APP_PORT=8080
FRONTEND_PORT=4200

TWELVE_DATA_API_KEY=replace_with_your_twelve_data_api_key

POSTGRES_USER=gestao
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_PORT=5432

MYSQL_DATABASE=gestaodeacao
MYSQL_USER=gestao
MYSQL_PASSWORD=replace_with_local_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_local_mysql_root_password
MYSQL_PORT=3306
